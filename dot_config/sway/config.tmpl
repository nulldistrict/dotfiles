# ============================================================
# Variables
# ============================================================

{{ $profile := index .machines .chezmoi.hostname -}}
set $mod Mod4
set $lock ~/.local/bin/sway-lock

set $left h
set $down j
set $up k
set $right l

set $term ghostty
set $menu fuzzel


# ============================================================
# Theme
# ============================================================

set {
    $black     #1c1c1c
    $panel     #242424
    $line      #444444
    $accent    #cfa36e
    $highlight #cfa36e
    $amber     #cfa36e
    $red       #e00712
    $muted     #888888
    $text      #d8d8d8
}

#                         border    bgrnd     text       indic       child
client.focused            $accent   $panel    $text      $highlight  $accent
client.unfocused          $line     $black    $muted     $line       $line
client.focused_inactive   $line     $black    $muted     $line       $line
client.focused_tab_title  $panel    $panel    $text
client.urgent             $red      $panel    $text      $red        $red
client.placeholder        $line     $black    $text      $line       $line

font pango:IBM Plex Mono 10

default_border pixel 2
default_floating_border pixel 2

titlebar_border_thickness 2
titlebar_padding 6 4


hide_edge_borders none
show_marks yes

focus_follows_mouse no
focus_on_window_activation smart


# ============================================================
# Inputs
# ============================================================

input "type:keyboard" {
    xkb_layout tr
    repeat_delay 250
    repeat_rate 35
}

input "type:pointer" {
    pointer_accel 0
}

{{ if eq $profile.type "laptop" }}
input "type:touchpad" {
    tap disabled
    natural_scroll enabled
}
{{ end }}


# ============================================================
# Outputs
# ============================================================

output * bg #1c1c1c solid_color

{{ if eq .chezmoi.hostname "molly" }}
output DP-1 {
    mode 1920x1080@60Hz
    position 0 0
    scale 1
}

output HDMI-A-1 {
    mode 1920x1080@60Hz
    position 1920 0
    scale 1
}
{{ end }}


# ============================================================
# Applications
# ============================================================

# Sway keybinding help
bindsym $mod+Ctrl+h exec ~/.local/bin/sway-help

# Terminal
bindsym $mod+Return exec $term

# Launcher
bindsym $mod+Space exec $menu

# Last notification
bindsym $mod+Ctrl+n exec makoctl restore

# Kill window
bindsym $mod+Escape kill

# Kill window without the compact keyboard's Fn layer
{{ if eq .chezmoi.hostname "molly" }}
bindsym $mod+q kill
{{ end }}

# Lock
bindsym $mod+Ctrl+l exec $lock

# Reload Sway
bindsym $mod+Shift+c reload

# Exit Sway
bindsym $mod+Shift+e exec swaynag \
    -t warning \
    -m 'EXIT SWAY SESSION' \
    -b 'YES' 'swaymsg exit'


# ============================================================
# Audio / media
# ============================================================

# Mute audio
bindsym --locked --no-repeat XF86AudioMute exec \
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Lower volume
bindsym --locked XF86AudioLowerVolume exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Raise volume
bindsym --locked XF86AudioRaiseVolume exec \
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# Previous track
bindsym XF86AudioPrev exec playerctl previous

# Play / pause
bindsym XF86AudioPlay exec playerctl play-pause

# Next track
bindsym XF86AudioNext exec playerctl next

# Compact keyboard media controls without function keys
{{ if eq .chezmoi.hostname "molly" }}
bindsym $mod+Ctrl+Down exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym $mod+Ctrl+Up exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym $mod+Ctrl+m exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym $mod+Ctrl+Space exec playerctl play-pause
bindsym $mod+Mod1+Left exec playerctl previous
bindsym $mod+Mod1+Right exec playerctl next
{{ end }}


# ============================================================
# Laptop brightness
# ============================================================

{{ if eq $profile.type "laptop" }}

# Lower display brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Raise display brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5%

{{ end }}

{{ if $profile.dell_awcc }}
# Open Dell lighting and thermal controls; the daemon handles hardware hotkeys
bindsym $mod+Ctrl+g exec awcc --gui
{{ end }}


# ============================================================
# MacBook keyboard backlight
# ============================================================

{{ if eq .chezmoi.hostname "badapple" }}

# Lower keyboard backlight
bindsym XF86KbdBrightnessDown exec \
    brightnessctl --device='smc::kbd_backlight' set 10%-

# Raise keyboard backlight
bindsym XF86KbdBrightnessUp exec \
    brightnessctl --device='smc::kbd_backlight' set +10%

{{ end }}


# ============================================================
# Mod + function keys
# ============================================================

# Mute audio
bindsym $mod+F1 exec \
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

# Lower volume
bindsym $mod+F2 exec \
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Raise volume
bindsym $mod+F3 exec \
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# Previous track
bindsym $mod+F5 exec playerctl previous

# Play / pause
bindsym $mod+F6 exec playerctl play-pause

# Next track
bindsym $mod+F7 exec playerctl next

{{ if or (eq .chezmoi.hostname "funkypunk") (eq .chezmoi.hostname "badapple") }}

# Lower display brightness
bindsym $mod+F8 exec brightnessctl set 5%-

# Raise display brightness
bindsym $mod+F9 exec brightnessctl set +5%

{{ end }}


# ============================================================
# Screenshots
# ============================================================

{{ if eq .chezmoi.hostname "molly" }}
# Save selected region to a file
bindsym $mod+a exec ~/.local/bin/sway-screenshot area

# Save all outputs to a file
bindsym $mod+Shift+a exec ~/.local/bin/sway-screenshot screen

# Copy selected region to clipboard
bindsym $mod+Ctrl+a exec ~/.local/bin/sway-screenshot clipboard

# Save the focused window to a file
bindsym $mod+Mod1+a exec ~/.local/bin/sway-screenshot window

{{ else }}
# Keep dedicated PrintScreen keys usable on laptop keyboards
bindsym Print exec ~/.local/bin/sway-screenshot screen
bindsym Shift+Print exec ~/.local/bin/sway-screenshot area
bindsym $mod+Print exec ~/.local/bin/sway-screenshot clipboard
{{ end }}

# Pick a screen color and copy it to clipboard
bindsym $mod+Shift+p exec hyprpicker --autocopy


# ============================================================
# Focus
# ============================================================

# Focus left
bindsym $mod+$left focus left

# Focus down
bindsym $mod+$down focus down

# Focus up
bindsym $mod+$up focus up

# Focus right
bindsym $mod+$right focus right

# Focus left with arrow
bindsym $mod+Left focus left

# Focus down with arrow
bindsym $mod+Down focus down

# Focus up with arrow
bindsym $mod+Up focus up

# Focus right with arrow
bindsym $mod+Right focus right

# Focus parent
bindsym $mod+Ctrl+p focus parent

# Move focus between parent containers
bindsym $mod+Mod1+$left focus parent, focus left, focus child
bindsym $mod+Mod1+$down focus parent, focus down, focus child
bindsym $mod+Mod1+$up focus parent, focus up, focus child
bindsym $mod+Mod1+$right focus parent, focus right, focus child


# ============================================================
# Move windows
# ============================================================

# Move window left
bindsym $mod+Shift+$left move left

# Move window down
bindsym $mod+Shift+$down move down

# Move window up
bindsym $mod+Shift+$up move up

# Move window right
bindsym $mod+Shift+$right move right

# Move window left with arrow
bindsym $mod+Shift+Left move left

# Move window down with arrow
bindsym $mod+Shift+Down move down

# Move window up with arrow
bindsym $mod+Shift+Up move up

# Move window right with arrow
bindsym $mod+Shift+Right move right


# ============================================================
# Workspaces
# ============================================================

set $ws1 1
set $ws2 2
set $ws3 3
set $ws4 4
set $ws5 5
set $ws6 6
set $ws7 7
set $ws8 8
set $ws9 9
set $ws10 10

# Workspace 1
bindsym $mod+1 workspace number $ws1

# Workspace 2
bindsym $mod+2 workspace number $ws2

# Workspace 3
bindsym $mod+3 workspace number $ws3

# Workspace 4
bindsym $mod+4 workspace number $ws4

# Workspace 5
bindsym $mod+5 workspace number $ws5

# Workspace 6
bindsym $mod+6 workspace number $ws6

# Workspace 7
bindsym $mod+7 workspace number $ws7

# Workspace 8
bindsym $mod+8 workspace number $ws8

# Workspace 9
bindsym $mod+9 workspace number $ws9

# Workspace 10
bindsym $mod+0 workspace number $ws10


# Move window to workspace 1
bindsym $mod+Shift+1 move container to workspace number $ws1

# Move window to workspace 2
bindsym $mod+Shift+2 move container to workspace number $ws2

# Move window to workspace 3
bindsym $mod+Shift+3 move container to workspace number $ws3

# Move window to workspace 4
bindsym $mod+Shift+4 move container to workspace number $ws4

# Move window to workspace 5
bindsym $mod+Shift+5 move container to workspace number $ws5

# Move window to workspace 6
bindsym $mod+Shift+6 move container to workspace number $ws6

# Move window to workspace 7
bindsym $mod+Shift+7 move container to workspace number $ws7

# Move window to workspace 8
bindsym $mod+Shift+8 move container to workspace number $ws8

# Move window to workspace 9
bindsym $mod+Shift+9 move container to workspace number $ws9

# Move window to workspace 10
bindsym $mod+Shift+0 move container to workspace number $ws10

# Previous workspace
bindsym $mod+Ctrl+Left workspace prev

# Next workspace
bindsym $mod+Ctrl+Right workspace next


# ============================================================
# Layout
# ============================================================

# Split horizontally
bindsym $mod+b splith

# Split vertically
bindsym $mod+v splitv

# Stacking layout
bindsym $mod+s layout stacking

# Tabbed layout
bindsym $mod+t layout tabbed

# Toggle split layout
bindsym $mod+Shift+s layout toggle split

# Toggle floating
bindsym $mod+Shift+z floating toggle

# Toggle focus between tiling and floating
bindsym $mod+Tab focus mode_toggle

# Toggle fullscreen
bindsym $mod+z fullscreen toggle
bindsym $mod+f fullscreen toggle

floating_modifier $mod normal


# ============================================================
# Scratchpad
# ============================================================

# Show scratchpad
bindsym $mod+Ctrl+s scratchpad show

# Move window to scratchpad
bindsym $mod+Ctrl+Shift+s move scratchpad


# ============================================================
# Resize
# ============================================================

mode "resize" {

    # Shrink width
    bindsym $left resize shrink width 10px

    # Shrink height
    bindsym $down resize shrink height 10px

    # Grow height
    bindsym $up resize grow height 10px

    # Grow width
    bindsym $right resize grow width 10px

    # Shrink width with arrow
    bindsym Left resize shrink width 10px

    # Shrink height with arrow
    bindsym Down resize shrink height 10px

    # Grow height with arrow
    bindsym Up resize grow height 10px

    # Grow width with arrow
    bindsym Right resize grow width 10px

    # Move floating windows in small steps
    bindsym Shift+$left move left 10px
    bindsym Shift+$down move down 10px
    bindsym Shift+$up move up 10px
    bindsym Shift+$right move right 10px
    bindsym Shift+Left move left 10px
    bindsym Shift+Down move down 10px
    bindsym Shift+Up move up 10px
    bindsym Shift+Right move right 10px

    # Resize floating windows to common dimensions
    bindsym 6 resize set width 640px height 480px
    bindsym 0 resize set width 1024px height 768px

    # Leave resize mode
    bindsym Escape mode "default"

    # Leave resize mode
    bindsym Return mode "default"
}

# Enter resize mode
bindsym $mod+r mode "resize"



# ============================================================
# Window rules
# ============================================================

# Float and center audio controls.
for_window [app_id="^(org\.pulseaudio\.)?pavucontrol$"] floating enable, resize set width 900 px height 600 px, move position center
for_window [class="(?i)^Pavucontrol$"] floating enable, resize set width 900 px height 600 px, move position center

# Keep password prompts centered.
for_window [app_id="^org\.gnupg\.pinentry-qt$"] floating enable, move position center
for_window [class="(?i)^pinentry.*$"] floating enable, move position center
for_window [window_type="dialog"] floating enable, move position center

# Preserve the existing password-manager behavior.
for_window [app_id="keepassxc"] floating enable

# Float LibreWolf extension windows.
for_window [title="^Extension: .*" app_id="librewolf"] floating enable, move position center

# Center common English and Turkish file dialogs.
for_window [title="^(Open File|Open Files|Save File|Save As|Dosya Aç|Dosyaları Aç|Dosyayı Aç|Dosyayı Kaydet|Farklı Kaydet)$"] floating enable, move position center


for_window [shell="xwayland"] \
    title_format "<span>[X11] %title</span>"


# ============================================================
# Waybar
# ============================================================

bar {
    id mainbar
    output *
    swaybar_command waybar
}


# ============================================================
# Services
# ============================================================

# Select a random wallpaper on startup and reload
exec_always --no-startup-id ~/.local/bin/sway-wallpaper

# Pick another wallpaper without reloading
bindsym $mod+Ctrl+b exec ~/.local/bin/sway-wallpaper

# OpenSnitch tray interface
exec --no-startup-id opensnitch-ui

# Notifications
exec --no-startup-id mako

# Color temperature
exec_always --no-startup-id sh -c \
    'pkill -x wlsunset 2>/dev/null || true; \
     exec wlsunset -S 06:30 -s 19:30 -d 1800'


# Idle manager
exec --no-startup-id swayidle -w \
    timeout 600 '~/.local/bin/sway-lock' \
    timeout 900 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep '~/.local/bin/sway-lock' \
    after-resume 'swaymsg "output * power on"' \
    lock '~/.local/bin/sway-lock'


# ============================================================
# System
# ============================================================

include /etc/sway/config.d/*

# Window spacing
gaps inner 10
gaps outer 6
smart_gaps off

# NetworkManager tray applet
exec --no-startup-id nm-applet --indicator

# Start the graphical privilege authentication agent.
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Copy text from a selected screen region.
bindsym $mod+Ctrl+Shift+o exec ~/.local/bin/sway-ocr

# Open clipboard history.
bindsym $mod+Ctrl+v exec ~/.local/bin/sway-clipboard

# Record clipboard changes once per session.
exec --no-startup-id wl-paste --watch cliphist store

{{ if eq $profile.type "laptop" }}
# Show battery and power notifications.
exec --no-startup-id poweralertd
{{ end }}

# Select the audio output and move existing playback streams.
bindsym $mod+Ctrl+a exec ~/.local/bin/audio-router
