{{ $laptop := eq (index .machines .chezmoi.hostname).type "laptop" -}}
{
  "layer": "top",
  "position": "top",
  "height": 28,
  "name": "{{ if $laptop }}laptop{{ else }}desktop{{ end }}",

  "modules-left": [
    "privacy",
    "group/network",
    "group/resources",
    "custom/screenrecord",
    "custom/syncthing"
  ],

  "modules-center": [
    "group/taskbar"
  ],

  "modules-right": [
{{ if $laptop }}
    "backlight",
{{ end }}
    "wireplumber",
{{ if $laptop }}
    "battery",
{{ end }}
    "custom/weather",
    "group/clock"
  ],


  // ==========================================================
  // Privacy
  // ==========================================================

  "privacy": {
    "icon-spacing": 4,
    "icon-size": 16,
    "transition-duration": 250,

    "modules": [
      {
        "type": "screenshare",
        "tooltip": true
      },
      {
        "type": "audio-in",
        "tooltip": true
      }
    ]
  },


  // ==========================================================
  // Network
  // ==========================================================

  "group/network": {
    "orientation": "horizontal",

    "modules": [
      "network#stats",
      "network#connection",
      "custom/vpn"
    ],

    "drawer": {
      "transition-left-to-right": true,
      "transition-duration": 500
    }
  },

  "network#stats": {
    "family": "ipv4",

    "format":
      "BWD {bandwidthDownBytes} <span color='#7f7187'>{bandwidthUpBytes}</span>",

    "tooltip-format": "{ifname}"
  },

  "network#connection": {
    "family": "ipv4",

    "format": "{ifname}",

    "format-wifi":
      "WiFi {essid} <span color='#7f7187'>{signalStrength}%</span>",

    "format-ethernet":
      "ETH {ipaddr}/<span color='#7f7187'>{cidr}</span>",

    "format-disconnected": "OFF",

    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Disconnected"
  },

  "custom/vpn": {
    "format": "VPN <span color='#7f7187'>{}</span>",
    "return-type": "json",

    "exec": "~/.local/bin/waybar-vpn current",

    "on-click": "~/.local/bin/waybar-vpn connect",
    "on-click-middle": "~/.local/bin/waybar-vpn disconnect",
    "on-click-right": "~/.local/bin/get-public-ip-info",

    "interval": 30
  },


  // ==========================================================
  // Resources
  // ==========================================================

  "group/resources": {
    "orientation": "horizontal",

    "modules": [
      "cpu",
      "memory",
      "disk#root"
    ],

    "drawer": {
      "transition-left-to-right": true,
      "transition-duration": 500
    }
  },

  "cpu": {
    "interval": 30,

    "format":
      "CPU <span color='#7f7187'>{usage}%</span>",

    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "interval": 60,

    "format":
      "MEM {used:3.1f}GiB/<span color='#7f7187'>{total:3.1f}GiB</span>"
  },

  "disk#root": {
    "interval": 360,
    "path": "/",

    "format":
      "SSD {used}/<span color='#7f7187'>{total}</span>"
  },


  // ==========================================================
  // Screen recording
  // ==========================================================

  "custom/screenrecord": {
    "format": "{}",
    "return-type": "json",

    "exec": "~/.local/bin/waybar-screenrecord",
    "on-click": "~/.local/bin/waybar-screenrecord toggle",

    "interval": 3
  },


  // ==========================================================
  // Syncthing
  // ==========================================================

  "custom/syncthing": {
    "format": "{}",
    "return-type": "json",

    "exec": "~/.local/bin/waybar-syncthing",

    "interval": 30
  },


  // ==========================================================
  // Taskbar
  // ==========================================================

  "group/taskbar": {
    "orientation": "horizontal",

    "modules": [
      "sway/window",
      "sway/workspaces",
      "sway/mode",
      "tray"
    ],

    "drawer": {
      "transition-left-to-right": true,
      "transition-duration": 500
    }
  },

  "sway/window": {
    "all-outputs": false,
    "format": "{}",
    "icon": false,

    "max-length": {{ if $laptop }}40{{ else }}160{{ end }},

    "rewrite": {
      "(.*) — LibreWolf": "WEB $1",
      "(.*) - Chromium": "WEB $1",
      "zsh (.*)": "ZSH $1"
    }
  },

  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,

    "format": "{icon}",

    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "default": "・"
    }
  },

  "sway/mode": {
    "format": "{}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 4
  },


  // ==========================================================
  // Backlight
  // ==========================================================

{{ if $laptop }}
  "backlight": {
    "format":
      "BRT <span color='#7f7187'>{percent}%</span>",

    "tooltip": false
  },
{{ end }}


  // ==========================================================
  // Audio
  // ==========================================================

  "wireplumber": {
    "format":
      "{icon} <span color='#7f7187'>{volume}%</span>",

    "format-muted": " X ",

    "format-icons": [
      "+--",
      "++-",
      "+++"
    ],

    "on-click": "pavucontrol"
  },


  // ==========================================================
  // Battery
  // ==========================================================

{{ if $laptop }}
  "battery": {
    "interval": 30,

    "states": {
      "warning": 10,
      "critical": 5
    },

    "format-time": "{H}:{m}",
    "tooltip": true,
    "tooltip-format": "{timeTo}\nPower: {power:.1f} W",

    "format":
      "{icon} <span color='#7f7187'>{capacity}%</span>",

    "format-discharging":
      "{icon} <span color='#b89ad0'>{capacity}%</span>",

    "format-discharging-warning":
      "{icon} <span color='#c98b5b'>{capacity}%</span>",

    "format-discharging-critical":
      "{icon} <span color='#8f2d3c'>{capacity}%</span>",

    "format-charging":
      "CHG <span color='#e6dfe8'>{capacity}%</span>",

    "format-full":
      "{icon} <span color='#7f7187'>{capacity}%</span>",

    "format-not-charging":
      "NOP <span color='#7f7187'>{capacity}%</span>",

    "format-icons": [
      "---",
      "#--",
      "##-",
      "###",
      "PWR"
    ]
  },
{{ end }}


  // ==========================================================
  // Weather
  // ==========================================================

  "custom/weather": {
    "exec": "~/.local/bin/waybar-weather",
    "return-type": "json",

    "interval": 1800,

    "format": "{}",

    "tooltip": true
  },


  // ==========================================================
  // Clock
  // ==========================================================

  "group/clock": {
    "orientation": "horizontal",

    "modules": [
      "clock#time",
      "clock#date"
    ],

    "drawer": {
      "transition-left-to-right": false,
      "transition-duration": 500
    }
  },

  "clock#time": {
    "interval": 60,

    "format": "{:%H:%M}",

    "tooltip": true,

    "tooltip-format": "{tz_list}",

    "timezones": [
      "Europe/Istanbul",
      "Etc/UTC"
    ]
  },

  "clock#date": {
    "interval": 60,

    "format":
      "<span color='#7f7187'> {:%d-%m-%Y}</span>",

    "tooltip-format":
      "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",

    "calendar": {
      "mode": "month",
      "weeks-pos": "right"
    }
  }
}
