#!/usr/bin/env bash
set -euo pipefail

# Cancel without changing the clipboard.
selection=$(
    cliphist list |
        fuzzel --dmenu --with-nth 2 --prompt 'Clipboard > '
) || exit 0

[[ -n "$selection" ]] || exit 0

# Restore the original content, including images and multiline text.
printf '%s\n' "$selection" | cliphist decode | wl-copy
